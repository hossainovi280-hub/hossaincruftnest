
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Poppins:wght@300;400;500;600;700&display=swap');

:root{
  --ink:#211c18;
  --ink-soft:#6f665e;
  --cream:#faf7f1;
  --paper:#fffdf9;
  --gold:#b8944d;
  --gold-deep:#8d6a2f;
  --line:#e8dfd2;
  --green:#23734b;
  --red:#b43b35;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  background:var(--cream);
  color:var(--ink);
  font-family:'Poppins',sans-serif;
  font-size:15px;
  line-height:1.6;
}

a{
  color:inherit;
  text-decoration:none;
}

button,
input,
textarea,
select{
  font:inherit;
}

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(255,253,249,.96);
  border-bottom:1px solid var(--line);
  backdrop-filter:blur(12px);
}

.nav-wrap{
  max-width:1200px;
  margin:auto;
  min-height:82px;
  padding:12px 24px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:25px;
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
}

.brand img{
  width:48px;
  height:48px;
  object-fit:contain;
}

.names{
  display:flex;
  flex-direction:column;
}

.name-en{
  font-family:'Cormorant Garamond',serif;
  font-size:25px;
  font-weight:600;
  line-height:1;
}

.name-ar{
  font-size:11px;
  color:var(--gold-deep);
  margin-top:4px;
}

.links{
  display:flex;
  align-items:center;
  gap:28px;
}

.links a{
  font-size:13px;
  font-weight:500;
  color:var(--ink-soft);
  transition:.2s;
}

.links a:hover,
.links a.active{
  color:var(--gold-deep);
}

.nav-actions{
  display:flex;
  align-items:center;
  gap:14px;
}

.cart-btn{
  position:relative;
  font-size:22px;
}

.cart-count{
  position:absolute;
  top:-8px;
  right:-9px;
  width:18px;
  height:18px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:var(--gold);
  color:white;
  font-size:10px;
}

.burger{
  display:none;
  border:0;
  background:none;
  font-size:26px;
  cursor:pointer;
}

.stitch{
  width:100%;
  border-top:1px dashed #d5c5ac;
}

.stitch.small{
  margin-top:45px;
}

main{
  max-width:1200px;
  margin:auto;
  padding:0 24px;
}

.page{
  display:none;
  padding:70px 0;
}

.page.active{
  display:block;
}

.hero{
  min-height:540px;
  margin-top:25px;
  padding:90px 30px;
  border:1px solid var(--line);
  background:
    radial-gradient(circle at 80% 25%,rgba(184,148,77,.15),transparent 30%),
    radial-gradient(circle at 15% 80%,rgba(184,148,77,.09),transparent 30%),
    var(--paper);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
}

.eyebrow{
  color:var(--gold-deep);
  text-transform:uppercase;
  letter-spacing:.2em;
  font-size:12px;
  font-weight:600;
}

.hero h1{
  margin:18px 0 8px;
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(42px,7vw,76px);
  line-height:.95;
  font-weight:500;
}

.sub-ar{
  color:var(--gold-deep);
  font-size:18px;
  margin:8px 0;
}

.sub{
  max-width:650px;
  color:var(--ink-soft);
  margin:5px 0 28px;
}

.ar{
  font-family:serif;
}

.btn{
  border:1px solid transparent;
  padding:13px 24px;
  min-height:48px;
  display:inline-flex;
  justify-content:center;
  align-items:center;
  cursor:pointer;
  font-size:13px;
  font-weight:600;
  transition:.2s;
}

.btn-gold{
  background:var(--gold);
  color:white;
}

.btn-gold:hover{
  background:var(--gold-deep);
}

.btn-outline{
  border-color:var(--gold);
  color:var(--gold-deep);
  background:transparent;
}

.btn-outline:hover{
  background:#f3eadc;
}

.btn-whatsapp{
  background:var(--green);
  color:white;
}

.btn-block{
  width:100%;
}

.btn-sm{
  padding:9px 15px;
  min-height:40px;
}

.section-head{
  text-align:center;
}

.section-head h2,
.page-title-block h2{
  font-family:'Cormorant Garamond',serif;
  font-size:42px;
  font-weight:500;
  margin-top:5px;
}

.cat-strip{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  justify-content:center;
  margin-top:25px;
}

.cat-chip{
  padding:9px 15px;
  border:1px solid var(--line);
  background:var(--paper);
  font-size:12px;
  transition:.2s;
}

.cat-chip:hover{
  border-color:var(--gold);
  color:var(--gold-deep);
}

.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  margin-top:28px;
}

.card{
  background:var(--paper);
  border:1px solid var(--line);
  cursor:pointer;
  transition:.25s;
}

.card:hover{
  transform:translateY(-4px);
  box-shadow:0 12px 30px rgba(40,30,20,.08);
}

.thumb{
  position:relative;
  aspect-ratio:1/1;
  background:#f4efe7;
  overflow:hidden;
}

.thumb img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.badge{
  position:absolute;
  top:10px;
  left:10px;
  padding:5px 9px;
  background:white;
  font-size:10px;
  font-weight:600;
}

.badge.in{
  color:var(--green);
}

.badge.out{
  color:var(--red);
}

.info{
  padding:15px;
  display:flex;
  flex-direction:column;
}

.cat-tag{
  color:var(--gold-deep);
  text-transform:uppercase;
  letter-spacing:.08em;
  font-size:9px;
}

.pname{
  font-family:'Cormorant Garamond',serif;
  font-size:22px;
  font-weight:600;
  margin:3px 0;
}

.price{
  font-weight:600;
  font-size:13px;
}

.page-title-block{
  margin-bottom:35px;
}

.products-layout{
  display:grid;
  grid-template-columns:240px 1fr;
  gap:35px;
}

.filter-panel,
.info-card,
.cart-summary{
  background:var(--paper);
  border:1px solid var(--line);
  padding:22px;
}

.filter-panel h3{
  font-family:'Cormorant Garamond',serif;
  font-size:25px;
  margin-bottom:20px;
}

.filter-group{
  border-top:1px solid var(--line);
  padding:18px 0;
}

.flabel,
.opt-label{
  display:block;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.12em;
  font-weight:600;
  margin-bottom:10px;
}

.filter-list{
  display:flex;
  flex-direction:column;
  gap:8px;
}

.filter-list label{
  font-size:12px;
  color:var(--ink-soft);
}

.filter-list input{
  accent-color:var(--gold);
}

.swatch-row{
  display:flex;
  flex-wrap:wrap;
  gap:9px;
}

.swatch{
  width:25px;
  height:25px;
  border-radius:50%;
  border:2px solid white;
  outline:1px solid var(--line);
  cursor:pointer;
}

.swatch.selected{
  outline:2px solid var(--gold-deep);
}

select{
  width:100%;
  padding:9px;
  border:1px solid var(--line);
  background:white;
}

.toolbar{
  min-height:35px;
}

.count-text{
  color:var(--ink-soft);
  font-size:12px;
}

.breadcrumb{
  font-size:12px;
  color:var(--ink-soft);
  margin-bottom:25px;
}

.breadcrumb a{
  color:var(--gold-deep);
}

.pd-wrap{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:60px;
}

.pd-main-img{
  aspect-ratio:1/1;
  background:#f4efe7;
  border:1px solid var(--line);
}

.pd-main-img img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.pd-thumbs{
  display:flex;
  gap:10px;
  margin-top:12px;
}

.pd-thumbs .t{
  width:70px;
  height:70px;
  border:1px solid var(--line);
  cursor:pointer;
}

.pd-thumbs .t.active{
  border:2px solid var(--gold);
}

.pd-thumbs img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.pd-cat{
  color:var(--gold-deep);
  text-transform:uppercase;
  font-size:11px;
  letter-spacing:.15em;
}

.pd-name{
  font-family:'Cormorant Garamond',serif;
  font-size:50px;
  line-height:1;
  font-weight:500;
  margin:8px 0;
}

.pd-price{
  font-size:20px;
  font-weight:600;
  margin-bottom:8px;
}

.stock-line{
  font-size:12px;
  font-weight:600;
  margin-bottom:20px;
}

.stock-line.in{
  color:var(--green);
}

.stock-line.out{
  color:var(--red);
}

.pd-desc{
  color:var(--ink-soft);
  margin-bottom:25px;
}

.opt-block{
  margin:20px 0;
}

.size-row{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

.size-chip{
  padding:8px 13px;
  border:1px solid var(--line);
  background:white;
  cursor:pointer;
  font-size:12px;
}

.size-chip.selected{
  border-color:var(--gold);
  background:#f5ecdd;
}

.qty-box{
  display:flex;
  align-items:center;
  width:max-content;
  border:1px solid var(--line);
}

.qty-box button{
  width:38px;
  height:38px;
  border:0;
  background:white;
  cursor:pointer;
  font-size:18px;
}

.qty-box span{
  width:38px;
  text-align:center;
}

.row2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.pd-actions{
  margin-top:28px;
  display:flex;
  flex-direction:column;
  gap:10px;
}

.related-title{
  font-family:'Cormorant Garamond',serif;
  font-size:30px;
  font-weight:500;
  margin-top:70px;
}

.about-wrap{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:60px;
  align-items:center;
}

.about-visual{
  aspect-ratio:1/1;
  background:var(--paper);
  border:1px solid var(--line);
  display:grid;
  place-items:center;
  padding:50px;
}

.about-visual img{
  width:80%;
  max-height:400px;
  object-fit:contain;
}

.stat-row{
  display:flex;
  gap:15px;
  margin-top:35px;
}

.stat{
  flex:1;
  padding:18px 10px;
  border:1px solid var(--line);
  background:var(--paper);
  text-align:center;
}

.stat b{
  display:block;
  color:var(--gold-deep);
  font-family:'Cormorant Garamond',serif;
  font-size:30px;
}

.stat span{
  display:block;
  color:var(--ink-soft);
  font-size:10px;
}

.contact-wrap{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:25px;
}

.info-card{
  height:100%;
}

.info-row{
  display:flex;
  gap:13px;
  padding:13px 0;
  border-bottom:1px solid var(--line);
}

.ic{
  width:28px;
}

.info-row div{
  display:flex;
  flex-direction:column;
}

.info-row b{
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.08em;
}

.info-row span,
.info-row a{
  color:var(--ink-soft);
  font-size:12px;
}

.info-row a:hover{
  color:var(--gold-deep);
}

.map-frame{
  width:100%;
  height:260px;
  border:0;
  margin-top:20px;
}

.form-field{
  margin-bottom:17px;
}

.form-field label{
  display:block;
  font-size:11px;
  font-weight:600;
  margin-bottom:6px;
}

.form-field input,
.form-field textarea{
  width:100%;
  border:1px solid var(--line);
  background:white;
  padding:12px;
  outline:none;
}

.form-field input:focus,
.form-field textarea:focus{
  border-color:var(--gold);
}

.form-field textarea{
  min-height:150px;
  resize:vertical;
}

.cart-item{
  display:grid;
  grid-template-columns:80px 1fr auto auto;
  gap:15px;
  align-items:center;
  background:var(--paper);
  border:1px solid var(--line);
  padding:14px;
  margin-bottom:12px;
}

.cart-item img{
  width:80px;
  height:80px;
  object-fit:cover;
}

.ci-name{
  font-family:'Cormorant Garamond',serif;
  font-size:22px;
  font-weight:600;
}

.ci-meta{
  color:var(--ink-soft);
  font-size:11px;
}

.ci-remove{
  color:var(--red);
  font-size:11px;
  margin-top:7px;
  cursor:pointer;
}

.sum-row{
  display:flex;
  justify-content:space-between;
  padding:10px 0;
  border-bottom:1px solid var(--line);
  font-size:12px;
}

.sum-row.total{
  font-size:16px;
  font-weight:700;
  border-bottom:0;
  margin-top:5px;
}

.empty-state{
  text-align:center;
  padding:70px 20px;
  border:1px dashed var(--line);
  background:var(--paper);
  color:var(--ink-soft);
}

.empty-state .big{
  font-size:45px;
  margin-bottom:12px;
}

footer{
  background:#211c18;
  color:#eee6da;
  margin-top:40px;
}

.foot-wrap{
  max-width:1200px;
  margin:auto;
  padding:55px 24px;
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  gap:50px;
}

.foot-wrap h4{
  font-family:'Cormorant Garamond',serif;
  font-size:24px;
  margin-bottom:10px;
}

.foot-wrap p,
.foot-wrap a{
  display:block;
  color:#c7bfb5;
  font-size:12px;
  margin:7px 0;
}

.foot-wrap a:hover{
  color:white;
}

.foot-bottom{
  text-align:center;
  border-top:1px solid #403931;
  padding:18px;
  color:#aaa097;
  font-size:10px;
}

.whatsapp-float{
  position:fixed;
  right:20px;
  bottom:20px;
  width:55px;
  height:55px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:var(--green);
  color:white;
  font-size:25px;
  box-shadow:0 8px 25px rgba(0,0,0,.2);
  z-index:900;
}

.toast{
  position:fixed;
  left:50%;
  bottom:25px;
  transform:translate(-50%,20px);
  background:#211c18;
  color:white;
  padding:12px 18px;
  font-size:12px;
  opacity:0;
  pointer-events:none;
  transition:.25s;
  z-index:2000;
}

.toast.show{
  opacity:1;
  transform:translate(-50%,0);
}

@media(max-width:900px){

  .links{
    gap:16px;
  }

  .grid{
    grid-template-columns:repeat(3,1fr);
  }

  .products-layout{
    grid-template-columns:200px 1fr;
  }

  .pd-wrap,
  .about-wrap{
    gap:35px;
  }

}

@media(max-width:700px){

  .nav-wrap{
    min-height:70px;
    padding:10px 16px;
  }

  .brand img{
    width:40px;
    height:40px;
  }

  .name-en{
    font-size:21px;
  }

  .name-ar{
    font-size:9px;
  }

  .burger{
    display:block;
  }

  .links{
    display:none;
    position:absolute;
    top:70px;
    left:0;
    right:0;
    background:var(--paper);
    border-bottom:1px solid var(--line);
    padding:15px 20px;
    flex-direction:column;
    align-items:stretch;
    gap:0;
  }

  .links.open{
    display:flex;
  }

  .links a{
    padding:13px 0;
    border-bottom:1px solid var(--line);
  }

  main{
    padding:0 15px;
  }

  .page{
    padding:45px 0;
  }

  .hero{
    min-height:470px;
    padding:60px 18px;
  }

  .hero h1{
    font-size:48px;
  }

  .grid{
    grid-template-columns:repeat(2,1fr);
    gap:12px;
  }

  .products-layout,
  .pd-wrap,
  .about-wrap,
  .contact-wrap{
    grid-template-columns:1fr;
  }

  .filter-panel{
    order:0;
  }

  .pd-name{
    font-size:42px;
  }

  .stat-row{
    gap:8px;
  }

  .stat{
    padding:13px 5px;
  }

  .foot-wrap{
    grid-template-columns:1fr;
    gap:25px;
    padding:40px 20px;
  }

  .cart-item{
    grid-template-columns:65px 1fr;
  }

  .cart-item img{
    width:65px;
    height:65px;
  }

  .cart-item .qty-box,
  .cart-item > div:last-child{
    grid-column:2;
  }

}

@media(max-width:420px){

  .grid{
    grid-template-columns:1fr 1fr;
  }

  .hero h1{
    font-size:41px;
  }

  .row2{
    grid-template-columns:1fr;
  }

  .section-head h2,
  .page-title-block h2{
    font-size:35px;
  }

}
