
/* =========================================
   HOSSAIN CRAFTNEST — LUXURY V2
   BLACK + GOLD DESIGN SYSTEM
========================================= */

:root {
  --black: #0b0b0b;
  --black-2: #111111;
  --black-3: #181818;
  --gold: #c9a227;
  --gold-light: #e6c65c;
  --cream: #f7f3e9;
  --muted: #aaa49a;
  --white: #ffffff;
  --line: rgba(201, 162, 39, 0.22);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--black);
  color: var(--cream);
  font-family: "Poppins", sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
  cursor: pointer;
}

img {
  max-width: 100%;
  display: block;
}

/* =========================
   HEADER
========================= */

header {
  position: sticky;
  top: 0;
  z-index: 999;
  background: rgba(11, 11, 11, 0.88);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--line);
}

.nav-wrap {
  max-width: 1280px;
  margin: auto;
  padding: 16px 28px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand img {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 1px solid var(--gold);
  object-fit: cover;
}

.name-en {
  font-family: "Cormorant Garamond", serif;
  font-size: 1.45rem;
  color: var(--white);
  letter-spacing: 0.04em;
}

.name-ar {
  font-family: "Amiri", serif;
  color: var(--gold-light);
  font-size: 0.8rem;
}

nav.links {
  display: flex;
  align-items: center;
  gap: 34px;
}

nav.links a {
  color: #d7d1c5;
  font-size: 0.75rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  transition: 0.3s;
}

nav.links a:hover,
nav.links a.active {
  color: var(--gold-light);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.cart-btn {
  color: var(--gold-light);
  font-size: 1.3rem;
}

.cart-count {
  background: var(--gold);
  color: var(--black);
}

/* =========================
   GOLD LINE
========================= */

.stitch {
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    var(--gold),
    transparent
  );
  opacity: 0.7;
}

.stitch.small {
  height: 1px;
}

/* =========================
   MAIN
========================= */

main {
  max-width: 1280px;
  margin: auto;
  padding: 0 28px;
}

section {
  padding: 90px 0;
}

/* =========================
   HERO
========================= */

.hero {
  min-height: 82vh;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  text-align: center;

  padding: 90px 20px;

  position: relative;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 35%,
      rgba(201, 162, 39, 0.14),
      transparent 42%
    ),
    linear-gradient(
      180deg,
      #111111 0%,
      #090909 100%
    );
}

.hero::before {
  content: "";
  position: absolute;
  width: 600px;
  height: 600px;

  border: 1px solid rgba(201, 162, 39, 0.08);
  border-radius: 50%;

  top: 50%;
  left: 50%;

  transform: translate(-50%, -50%);
}

.hero .eyebrow {
  color: var(--gold-light);
  font-size: 0.72rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  margin-bottom: 22px;
}

.hero h1 {
  position: relative;

  font-family: "Cormorant Garamond", serif;
  font-size: clamp(3.2rem, 7vw, 6.5rem);
  line-height: 0.95;
  font-weight: 500;

  color: var(--white);

  max-width: 1000px;
  margin-bottom: 28px;
}

.hero h1::after {
  content: "";
  display: block;

  width: 80px;
  height: 1px;

  background: var(--gold);

  margin: 30px auto 0;
}

.hero .sub {
  max-width: 600px;

  color: var(--muted);
  font-size: 0.95rem;

  margin-bottom: 36px;
}

.hero .sub-ar {
  color: var(--gold-light);
}

/* =========================
   BUTTONS
========================= */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 48px;
  padding: 13px 30px;

  border-radius: 0;

  font-size: 0.72rem;
  font-weight: 600;

  letter-spacing: 0.16em;
  text-transform: uppercase;

  transition: all 0.3s ease;
}

.btn-gold {
  background: var(--gold);
  color: var(--black);
  border: 1px solid var(--gold);
}

.btn-gold:hover {
  background: var(--gold-light);
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(201, 162, 39, 0.2);
}

.btn-outline {
  background: transparent;
  color: var(--gold-light);
  border: 1px solid var(--gold);
}

.btn-outline:hover {
  background: var(--gold);
  color: var(--black);
}

.btn-whatsapp {
  background: #1f8a4c;
  color: white;
}

/* =========================
   SECTION TITLES
========================= */

.section-head,
.page-title-block {
  text-align: center;
  margin-bottom: 45px;
}

.section-head .eyebrow,
.page-title-block .eyebrow {
  color: var(--gold);
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  margin-bottom: 10px;
}

.section-head h2,
.page-title-block h2 {
  font-family: "Cormorant Garamond", serif;
  color: var(--white);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 500;
}

/* =========================
   CATEGORY
========================= */

.cat-strip {
  display: flex;
  gap: 12px;

  overflow-x: auto;

  padding-bottom: 15px;

  scrollbar-width: none;
}

.cat-strip::-webkit-scrollbar {
  display: none;
}

.cat-chip {
  flex: 0 0 auto;

  padding: 11px 22px;

  color: #d6d0c4;

  background: var(--black-2);

  border: 1px solid rgba(255,255,255,0.08);

  transition: 0.3s;
}

.cat-chip:hover {
  color: var(--gold-light);
  border-color: var(--gold);
  background: var(--black-3);
}

/* =========================
   PRODUCT GRID
========================= */

.grid {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 22px;
}

.card {
  background: var(--black-2);

  border: 1px solid rgba(255,255,255,0.08);

  border-radius: 0;

  overflow: hidden;

  transition: all 0.4s ease;
}

.card:hover {
  transform: translateY(-8px);

  border-color: rgba(201,162,39,0.5);

  box-shadow:
    0 20px 50px rgba(0,0,0,0.45);
}

.card .thumb {
  background: #171717;

  aspect-ratio: 1 / 1;

  overflow: hidden;
}

.card .thumb img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: transform 0.6s ease;
}

.card:hover .thumb img {
  transform: scale(1.07);
}

.card .info {
  padding: 20px;
  background: var(--black-2);
}

.card .cat-tag {
  color: var(--gold);

  font-size: 0.62rem;

  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.card .pname {
  display: block;

  color: var(--white);

  font-family: "Cormorant Garamond", serif;

  font-size: 1.4rem;

  margin: 5px 0;
}

.card .price {
  color: var(--gold-light);

  font-size: 0.85rem;
  font-weight: 600;
}

/* =========================
   ABOUT
========================= */

.about-wrap,
.contact-wrap,
.pd-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
}

.about-visual {
  background:
    radial-gradient(
      circle,
      rgba(201,162,39,0.18),
      transparent 60%
    ),
    #111;

  border: 1px solid var(--line);

  min-height: 520px;
}

.about-visual img {
  width: 150px;
}

/* =========================
   FILTER PANEL
========================= */

.filter-panel,
.info-card,
.cart-summary {
  background: var(--black-2);

  border: 1px solid rgba(255,255,255,0.08);

  color: var(--cream);
}

.filter-panel {
  padding: 24px;
}

.filter-panel h3 {
  color: var(--gold-light);
}

.filter-group .flabel {
  color: var(--gold);
}

.filter-list label {
  color: #c4beb2;
}

select,
.form-field input,
.form-field textarea {
  background: #0c0c0c;

  color: var(--white);

  border: 1px solid rgba(255,255,255,0.12);
}

/* =========================
   PRODUCT DETAIL
========================= */

.pd-main-img {
  background: #151515;

  border: 1px solid rgba(255,255,255,0.08);
}

.pd-cat {
  color: var(--gold);
}

.pd-name {
  color: var(--white);

  font-family: "Cormorant Garamond", serif;

  font-size: clamp(2.4rem, 5vw, 4rem);
}

.pd-price {
  color: var(--gold-light);
}

.pd-desc {
  color: var(--muted);
}

.opt-label {
  color: var(--gold);
}

.size-chip {
  color: var(--cream);
  border-color: rgba(255,255,255,0.15);
}

.size-chip.selected {
  background: var(--gold);
  color: var(--black);
  border-color: var(--gold);
}

/* =========================
   CONTACT
========================= */

.info-card {
  padding: 30px;
}

.info-row b {
  color: var(--gold-light);
}

.info-row span,
.info-row a {
  color: var(--muted);
}

.map-frame {
  filter: grayscale(100%) contrast(1.1);
  opacity: 0.8;
}

/* =========================
   CART
========================= */

.cart-item {
  border-color: rgba(255,255,255,0.08);
}

.ci-name {
  color: var(--white);
}

.ci-meta {
  color: var(--muted);
}

.qty-box {
  border-color: rgba(255,255,255,0.15);
}

.qty-box button,
.qty-box span {
  color: var(--white);
}

.cart-summary h3 {
  color: var(--gold-light);
}

/* =========================
   FOOTER
========================= */

footer {
  background: #050505;

  border-top: 1px solid var(--line);

  color: var(--muted);
}

footer h4 {
  color: var(--gold-light);

  font-family: "Cormorant Garamond", serif;

  font-size: 1.35rem;
}

footer a:hover {
  color: var(--gold-light);
}

.foot-bottom {
  border-color: rgba(255,255,255,0.08);
}

/* =========================
   WHATSAPP
========================= */

.whatsapp-float {
  background: #1f8a4c;

  width: 58px;
  height: 58px;

  box-shadow: 0 10px 30px rgba(0,0,0,0.5);

  transition: 0.3s;
}

.whatsapp-float:hover {
  transform: scale(1.08);
}

/* =========================
   MOBILE
========================= */

@media (max-width: 980px) {

  .grid {
    grid-template-columns: repeat(3, 1fr);
  }

}

@media (max-width: 860px) {

  nav.links {
    background: #0b0b0b;
  }

  .about-wrap,
  .contact-wrap,
  .pd-wrap {
    grid-template-columns: 1fr;
  }

  .grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero {
    min-height: 75vh;
  }

}

@media (max-width: 600px) {

  main {
    padding: 0 16px;
  }

  section {
    padding: 65px 0;
  }

  .nav-wrap {
    padding: 13px 16px;
  }

  .brand img {
    width: 40px;
    height: 40px;
  }

  .name-en {
    font-size: 1.2rem;
  }

  .hero {
    min-height: 70vh;
    padding: 70px 10px;
  }

  .hero h1 {
    font-size: clamp(2.8rem, 13vw, 4rem);
  }

  .hero .sub {
    font-size: 0.85rem;
  }

  .grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .card .info {
    padding: 14px;
  }

  .card .pname {
    font-size: 1.15rem;
  }

  .card .price {
    font-size: 0.78rem;
  }

  .about-visual {
    min-height: 360px;
  }

  .whatsapp-float {
    width: 52px;
    height: 52px;
    right: 16px;
    bottom: 16px;
  }

}
